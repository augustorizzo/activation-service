{
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/activate",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.productCode",
          "equalTo": "PROVIDER-ERROR"
        }
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message": "Falha simulada do provedor"
    }
  }
}